{
  "manifest_version": 3,
  "name": "Smooth Video for ABS Online Learning (unofficial)",
  "short_name": "ABS Smooth Video",
  "version": "1.1.0",
  "description": "Unofficial fix that stops American Bonanza Society Online Learning Center videos from freezing every few seconds.",
  "homepage_url": "https://github.com/taylorbentz/abs-smooth-video",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://abs.topclasslms.com/*"
      ],
      "js": [
        "fix.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
